<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CommandTray.Ui.ClientApplication">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TrayCanvas">#EAF0F8</SolidColorBrush>
          <SolidColorBrush x:Key="TrayPaper">#F8FAFE</SolidColorBrush>
          <SolidColorBrush x:Key="TrayChrome">#E2EAF5</SolidColorBrush>
          <SolidColorBrush x:Key="TrayInk">#17263A</SolidColorBrush>
          <SolidColorBrush x:Key="TraySecondary">#4A5C75</SolidColorBrush>
          <SolidColorBrush x:Key="TrayLine">#CAD6E7</SolidColorBrush>
          <SolidColorBrush x:Key="TrayAccent">#2259A8</SolidColorBrush>
          <SolidColorBrush x:Key="TrayAccentOn">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="TrayError">#982B37</SolidColorBrush>
          <SolidColorBrush x:Key="TraySelection">#DCE9FF</SolidColorBrush>
          <SolidColorBrush x:Key="TrayHover">#E7EDF7</SolidColorBrush>
          <SolidColorBrush x:Key="TrayMutedFill">#E9F0FA</SolidColorBrush>
          <SolidColorBrush x:Key="FolderMark">#186480</SolidColorBrush>
          <SolidColorBrush x:Key="TerminalMark">#62499E</SolidColorBrush>
          <SolidColorBrush x:Key="NoteMark">#805018</SolidColorBrush>
          <SolidColorBrush x:Key="TrayControlLine">#62799C</SolidColorBrush>
          <SolidColorBrush x:Key="TrayAccentHover">#1A4B92</SolidColorBrush>
          <SolidColorBrush x:Key="TraySuccess">#176042</SolidColorBrush>
          <SolidColorBrush x:Key="TrayWarning">#754707</SolidColorBrush>
          <SolidColorBrush x:Key="TrayDangerFill">#982B37</SolidColorBrush>
          <SolidColorBrush x:Key="TrayDangerOn">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="TrayDangerHover">#81212B</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="TrayCanvas">#0F151E</SolidColorBrush>
          <SolidColorBrush x:Key="TrayPaper">#182230</SolidColorBrush>
          <SolidColorBrush x:Key="TrayChrome">#202C3C</SolidColorBrush>
          <SolidColorBrush x:Key="TrayInk">#EDF2F9</SolidColorBrush>
          <SolidColorBrush x:Key="TraySecondary">#AAB9CC</SolidColorBrush>
          <SolidColorBrush x:Key="TrayLine">#34445A</SolidColorBrush>
          <SolidColorBrush x:Key="TrayAccent">#8DB8FF</SolidColorBrush>
          <SolidColorBrush x:Key="TrayAccentOn">#111F32</SolidColorBrush>
          <SolidColorBrush x:Key="TrayError">#FFADB0</SolidColorBrush>
          <SolidColorBrush x:Key="TraySelection">#263D5B</SolidColorBrush>
          <SolidColorBrush x:Key="TrayHover">#27364A</SolidColorBrush>
          <SolidColorBrush x:Key="TrayMutedFill">#202D40</SolidColorBrush>
          <SolidColorBrush x:Key="FolderMark">#80C8DC</SolidColorBrush>
          <SolidColorBrush x:Key="TerminalMark">#C4B5FD</SolidColorBrush>
          <SolidColorBrush x:Key="NoteMark">#EBC383</SolidColorBrush>
          <SolidColorBrush x:Key="TrayControlLine">#667D9B</SolidColorBrush>
          <SolidColorBrush x:Key="TrayAccentHover">#A9C9FF</SolidColorBrush>
          <SolidColorBrush x:Key="TraySuccess">#78D8AE</SolidColorBrush>
          <SolidColorBrush x:Key="TrayWarning">#F2C879</SolidColorBrush>
          <SolidColorBrush x:Key="TrayDangerFill">#FFADB0</SolidColorBrush>
          <SolidColorBrush x:Key="TrayDangerOn">#39151C</SolidColorBrush>
          <SolidColorBrush x:Key="TrayDangerHover">#FFC5C7</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <x:Double x:Key="TrayFontSmall">11</x:Double>
      <x:Double x:Key="TrayFontCaption">12</x:Double>
      <x:Double x:Key="TrayFontDetail">13</x:Double>
      <x:Double x:Key="TrayFontBody">14</x:Double>
      <x:Double x:Key="TrayFontSection">15</x:Double>
      <x:Double x:Key="TrayFontLarge">16</x:Double>
      <x:Double x:Key="TrayFontTitle">17</x:Double>
      <x:Double x:Key="TrayReadingLineHeight">22</x:Double>
      <x:Double x:Key="TextControlPlaceholderOpacity">1</x:Double>
      <SolidColorBrush x:Key="ShellPaper">#141D29</SolidColorBrush>
      <SolidColorBrush x:Key="ShellInk">#EDF2F9</SolidColorBrush>
      <SolidColorBrush x:Key="ShellMuted">#AAB9CC</SolidColorBrush>
      <SolidColorBrush x:Key="ShellLine">#34445A</SolidColorBrush>
      <SolidColorBrush x:Key="ShellSelection">#263D5B</SolidColorBrush>
      <SolidColorBrush x:Key="ShellAccent">#8DB8FF</SolidColorBrush>
      <DrawingBrush x:Key="TrayDotGrid" TileMode="Tile" Stretch="None"
                    SourceRect="0,0,24,24" DestinationRect="0,0,24,24">
        <DrawingBrush.Drawing>
          <DrawingGroup>
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
            <GeometryDrawing Brush="#537D9CB7">
              <GeometryDrawing.Geometry>
                <EllipseGeometry Center="12,12" RadiusX="0.8" RadiusY="0.8" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
          </DrawingGroup>
        </DrawingBrush.Drawing>
      </DrawingBrush>
      <SolidColorBrush x:Key="TerminalInk">#D7E6FA</SolidColorBrush>
      <SolidColorBrush x:Key="TerminalPaper">#111A27</SolidColorBrush>
      <SolidColorBrush x:Key="TerminalLine">#34445A</SolidColorBrush>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#2259A8" />
        <ColorPaletteResources x:Key="Dark" Accent="#8DB8FF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="UserControl.tray-root">
      <Setter Property="Background" Value="{DynamicResource TrayPaper}" />
      <Setter Property="Foreground" Value="{DynamicResource TrayInk}" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontBody}" />
    </Style>
    <Style Selector="UserControl.tray-root.wide">
      <Setter Property="Background" Value="{DynamicResource TrayCanvas}" />
    </Style>
    <Style Selector="Border.chrome">
      <Setter Property="Background" Value="{StaticResource ShellPaper}" />
      <Setter Property="BorderBrush" Value="{StaticResource ShellLine}" />
    </Style>
    <Style Selector="Border.mark">
      <Setter Property="Background" Value="{StaticResource ShellAccent}" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource TraySecondary}" />
      <Setter Property="StrokeThickness" Value="1.65" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Path.glyph.mark">
      <Setter Property="Stroke" Value="#111F32" />
    </Style>
    <Style Selector="Button.primary Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource TrayAccentOn}" />
    </Style>
    <Style Selector="Button.selected Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource TrayAccent}" />
    </Style>
    <Style Selector="TextBlock.brand">
      <Setter Property="Foreground" Value="{StaticResource ShellInk}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontDetail}" />
    </Style>
    <Style Selector="Border.nav-footer">
      <Setter Property="BorderBrush" Value="{StaticResource ShellLine}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="0,7,0,0" />
    </Style>
    <Style Selector="Border.nav-group">
      <Setter Property="BorderBrush" Value="{StaticResource ShellLine}" />
    </Style>
    <Style Selector="TextBlock.nav-status">
      <Setter Property="Foreground" Value="{StaticResource ShellMuted}" />
      <Setter Property="Margin" Value="10,4" />
    </Style>
    <Style Selector="TextBlock.nav-heading">
      <Setter Property="FontSize" Value="{DynamicResource TrayFontCaption}" />
      <Setter Property="Foreground" Value="{StaticResource ShellMuted}" />
      <Setter Property="Margin" Value="10,5,0,2" />
    </Style>
    <Style Selector="Button.action.nav-add-space">
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="GridSplitter.sidebar-splitter">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Border x:Name="ResizeMark" Width="2" Height="26" VerticalAlignment="Center"
                    HorizontalAlignment="Right" Background="{StaticResource ShellMuted}"
                    Opacity="0.48" CornerRadius="1" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter.sidebar-splitter:pointerover /template/ Border#ResizeMark">
      <Setter Property="Background" Value="{StaticResource ShellAccent}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="GridSplitter.sidebar-splitter:focus-visible /template/ Border#ResizeMark">
      <Setter Property="Background" Value="{StaticResource ShellAccent}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TraySecondary}" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TrayHover}" />
      <Setter Property="Foreground" Value="{DynamicResource TrayInk}" />
    </Style>
    <Style Selector="Button.action:disabled">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.action.icon-only">
      <Setter Property="Width" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action.primary">
      <Setter Property="Background" Value="{DynamicResource TrayAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource TrayAccentOn}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.action.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TrayAccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource TrayAccentOn}" />
    </Style>
    <Style Selector="Button.action.secondary">
      <Setter Property="Foreground" Value="{DynamicResource TrayInk}" />
      <Setter Property="Background" Value="{DynamicResource TrayMutedFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayControlLine}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.action.danger">
      <Setter Property="Foreground" Value="{DynamicResource TrayDangerOn}" />
      <Setter Property="Background" Value="{DynamicResource TrayDangerFill}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.action.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TrayDangerOn}" />
      <Setter Property="Background" Value="{DynamicResource TrayDangerHover}" />
    </Style>
    <Style Selector="Button.action:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource TrayAccent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource TrayPaper}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayControlLine}" />
    </Style>
    <Style Selector="Button.action.navigation">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Button.action.navigation.selected">
      <Setter Property="Background" Value="{DynamicResource TraySelection}" />
      <Setter Property="Foreground" Value="{DynamicResource TrayInk}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.sidebar Button.action.navigation.nav-main-entry">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource ShellInk}" />
    </Style>
    <Style Selector="Border.sidebar Button.action.navigation.nav-overview">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontDetail}" />
      <Setter Property="Foreground" Value="{StaticResource ShellInk}" />
    </Style>
    <Style Selector="Border.sidebar Button.action.navigation.nav-sub-entry">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="19,2,8,2" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontDetail}" />
    </Style>
    <Style Selector="Border.sidebar Button.action.navigation.nav-footer-entry">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontDetail}" />
    </Style>
    <Style Selector="Border.sidebar Button.action.navigation.current-space">
      <Setter Property="Foreground" Value="{StaticResource ShellInk}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.sidebar Button.action.navigation.current-space Path.glyph">
      <Setter Property="Stroke" Value="{StaticResource ShellAccent}" />
    </Style>
    <Style Selector="Border.sidebar Button.action.navigation.selected">
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Button.action.space-tab">
      <Setter Property="Foreground" Value="{DynamicResource TraySecondary}" />
      <Setter Property="Margin" Value="0,0,3,0" />
    </Style>
    <Style Selector="Button.action.space-tab.selected">
      <Setter Property="Background" Value="{DynamicResource TraySelection}" />
      <Setter Property="Foreground" Value="{DynamicResource TrayInk}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Grid.compact Button.action">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.compact Button.action.icon-only">
      <Setter Property="Width" Value="48" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Grid.compact Button.action.navigation">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="3,3" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontCaption}" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="Grid.android Button.action, Grid.android ComboBox, Grid.android TextBox, MenuItem.android">
      <Setter Property="FontSize" Value="{DynamicResource TrayFontBody}" />
    </Style>
    <Style Selector="Grid.android Button.action.navigation">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontCaption}" />
    </Style>
    <Style Selector="Grid.compact ToggleSwitch">
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TraySecondary}" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontCaption}" />
    </Style>
    <Style Selector="TextBlock.form-error">
      <Setter Property="Foreground" Value="{DynamicResource TrayError}" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontDetail}" />
    </Style>
    <Style Selector="TextBlock.status-success">
      <Setter Property="Foreground" Value="{DynamicResource TraySuccess}" />
    </Style>
    <Style Selector="TextBlock.status-warning">
      <Setter Property="Foreground" Value="{DynamicResource TrayWarning}" />
    </Style>
    <Style Selector="TextBlock.status-error">
      <Setter Property="Foreground" Value="{DynamicResource TrayError}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontSection}" />
    </Style>
    <Style Selector="TextBlock.toolbar-title">
      <Setter Property="FontSize" Value="{DynamicResource TrayFontTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.column-label">
      <Setter Property="Foreground" Value="{DynamicResource TraySecondary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontSmall}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="SelectableTextBlock.reading">
      <Setter Property="FontSize" Value="{DynamicResource TrayFontSection}" />
      <Setter Property="LineHeight" Value="{DynamicResource TrayReadingLineHeight}" />
    </Style>
    <Style Selector="CheckBox.checklist-item /template/ Grid#RootGrid > Grid">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="BorderBrush" Value="{DynamicResource TrayLine}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="{DynamicResource TrayPaper}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
    </Style>
    <Style Selector="Border.tile.dragging">
      <Setter Property="BorderBrush" Value="{DynamicResource TrayAccent}" />
    </Style>
    <Style Selector="Border.tile.located">
      <Setter Property="BorderBrush" Value="{DynamicResource TrayAccent}" />
    </Style>
    <Style Selector="Border.tile.focused-panel">
      <Setter Property="BorderBrush" Value="{DynamicResource TrayAccent}" />
    </Style>
    <Style Selector="Border.tile-heading Button.action.icon-only">
      <Setter Property="Width" Value="30" />
    </Style>
    <Style Selector="Grid.compact Border.tile-heading Button.action.icon-only">
      <Setter Property="Width" Value="48" />
    </Style>
    <Style Selector="Border.tile-heading">
      <Setter Property="Background" Value="{DynamicResource TrayChrome}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayLine}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Path.glyph.folder-tone">
      <Setter Property="Stroke" Value="{DynamicResource FolderMark}" />
    </Style>
    <Style Selector="Path.glyph.terminal-tone">
      <Setter Property="Stroke" Value="{DynamicResource TerminalMark}" />
    </Style>
    <Style Selector="Path.glyph.note-tone">
      <Setter Property="Stroke" Value="{DynamicResource NoteMark}" />
    </Style>
    <Style Selector="Path.glyph.accent-tone">
      <Setter Property="Stroke" Value="{DynamicResource TrayAccent}" />
    </Style>
    <Style Selector="Grid.compact Border.tile">
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.file-path">
      <Setter Property="Background" Value="{DynamicResource TrayMutedFill}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="7,0,3,0" />
    </Style>
    <Style Selector="Button.action.file-entry">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="29" />
    </Style>
    <Style Selector="Button.action.file-entry-menu">
      <Setter Property="MinHeight" Value="29" />
    </Style>
    <Style Selector="Button.folder-entry Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource FolderMark}" />
    </Style>
    <Style Selector="Border.table">
      <Setter Property="Background" Value="{DynamicResource TrayPaper}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource TrayMutedFill}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="7,3" />
    </Style>
    <Style Selector="Border.chip.live">
      <Setter Property="Background" Value="{DynamicResource TraySelection}" />
    </Style>
    <Style Selector="TextBox.entry">
      <Setter Property="Background" Value="{DynamicResource TrayPaper}" />
      <Setter Property="Foreground" Value="{DynamicResource TrayInk}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayControlLine}" />
    </Style>
    <Style Selector="ComboBox, TextBox:not(.terminal)">
      <Setter Property="Foreground" Value="{DynamicResource TrayInk}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayControlLine}" />
    </Style>
    <Style Selector="TextBox:not(.terminal)">
      <Setter Property="PlaceholderForeground" Value="{DynamicResource TraySecondary}" />
    </Style>
    <Style Selector="TextBox.terminal">
      <Setter Property="Background" Value="{DynamicResource TerminalPaper}" />
      <Setter Property="Foreground" Value="{DynamicResource TerminalInk}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TerminalLine}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontDetail}" />
    </Style>
    <Style Selector="TextBox.terminal-input">
      <Setter Property="Background" Value="{DynamicResource TrayMutedFill}" />
      <Setter Property="FontFamily" Value="monospace" />
    </Style>
    <Style Selector="Border.chrome TextBlock.toolbar-title">
      <Setter Property="Foreground" Value="{StaticResource ShellInk}" />
    </Style>
    <Style Selector="Border.chrome Button.action">
      <Setter Property="Foreground" Value="{StaticResource ShellMuted}" />
    </Style>
    <Style Selector="Border.chrome Button.action Path.glyph">
      <Setter Property="Stroke" Value="{StaticResource ShellMuted}" />
    </Style>
    <Style Selector="Border.chrome Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ShellSelection}" />
      <Setter Property="Foreground" Value="{StaticResource ShellInk}" />
    </Style>
    <Style Selector="Border.chrome Button.action.secondary">
      <Setter Property="Foreground" Value="{DynamicResource TrayInk}" />
    </Style>
    <Style Selector="Border.chrome Button.action.primary">
      <Setter Property="Foreground" Value="{DynamicResource TrayAccentOn}" />
    </Style>
    <Style Selector="Border.chrome Button.action.primary Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource TrayAccentOn}" />
    </Style>
    <Style Selector="Border.chrome Button.action.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TrayAccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource TrayAccentOn}" />
    </Style>
    <Style Selector="Border.chrome Button.action.selected">
      <Setter Property="Background" Value="{StaticResource ShellSelection}" />
      <Setter Property="Foreground" Value="{StaticResource ShellInk}" />
      <Setter Property="BorderBrush" Value="{StaticResource ShellAccent}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style Selector="Border.topbar Button.action.space-tab.selected">
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="Grid.compact Border.sidebar Button.action.selected">
      <Setter Property="BorderThickness" Value="0,2,0,0" />
    </Style>
    <Style Selector="Border.chrome Button.action.selected Path.glyph">
      <Setter Property="Stroke" Value="{StaticResource ShellAccent}" />
    </Style>
    <Style Selector="Border.rail Button.action.navigation">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.topbar Button.action.palette-toggle">
      <Setter Property="Background" Value="{StaticResource ShellSelection}" />
      <Setter Property="BorderBrush" Value="{StaticResource ShellLine}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.topbar Button.action.add-component Path.glyph">
      <Setter Property="Stroke" Value="{StaticResource ShellAccent}" />
    </Style>
    <Style Selector="Border.palette">
      <Setter Property="Background" Value="{DynamicResource TrayPaper}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBox.palette-query">
      <Setter Property="Background" Value="{DynamicResource TrayCanvas}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayLine}" />
      <Setter Property="Foreground" Value="{DynamicResource TrayInk}" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontLarge}" />
      <Setter Property="Padding" Value="11,8" />
    </Style>
    <Style Selector="ListBox.palette-results">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.palette-results ListBoxItem">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="ListBox.palette-results ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TraySelection}" />
      <Setter Property="Foreground" Value="{DynamicResource TrayInk}" />
    </Style>
    <Style Selector="Border.keycap">
      <Setter Property="Background" Value="{StaticResource ShellPaper}" />
      <Setter Property="BorderBrush" Value="{StaticResource ShellLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,2" />
    </Style>
    <Style Selector="Border.keycap TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ShellMuted}" />
      <Setter Property="FontSize" Value="{DynamicResource TrayFontSmall}" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="{DynamicResource TraySelection}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayLine}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="TextBlock.section.workbench-heading">
      <Setter Property="FontSize" Value="34" />
      <Setter Property="Margin" Value="0,1,0,3" />
    </Style>
    <Style Selector="Grid.compact TextBlock.section.workbench-heading">
      <Setter Property="FontSize" Value="26" />
    </Style>
    <Style Selector="Border.workbench-panel-heading">
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayLine}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.board-chrome">
      <Setter Property="Background" Value="{DynamicResource TrayChrome}" />
      <Setter Property="Padding" Value="3,2" />
    </Style>
    <Style Selector="Button.action.board-tool">
      <Setter Property="Width" Value="32" />
      <Setter Property="MinHeight" Value="31" />
    </Style>
    <Style Selector="Button.action.workbench-tab">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.action.workbench-tab.selected">
      <Setter Property="Foreground" Value="{DynamicResource TrayAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.board-chrome Button.action.selected">
      <Setter Property="Background" Value="{DynamicResource TraySelection}" />
      <Setter Property="Foreground" Value="{DynamicResource TrayAccent}" />
    </Style>
    <Style Selector="Button.action.workbench-list-row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayLine}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.action.workbench-list-row.selected">
      <Setter Property="Background" Value="{DynamicResource TraySelection}" />
      <Setter Property="Foreground" Value="{DynamicResource TrayInk}" />
    </Style>
    <Style Selector="Border.detail-text">
      <Setter Property="Background" Value="{DynamicResource TrayCanvas}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TrayLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Grid#Toolbar">
      <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="Grid.compact Grid#Toolbar">
      <Setter Property="MinHeight" Value="46" />
    </Style>
  </Application.Styles>
</Application>
